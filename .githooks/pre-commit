#!/bin/sh
# Block commits whose staged changes contain secrets.
# Enable once per clone: git config core.hooksPath .githooks

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks not found; install it or commit with --no-verify" >&2
  exit 1
fi

exec gitleaks git --staged --redact --no-banner --verbose
