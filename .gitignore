.DS_Store
._*

# secrets and machine-local files. chezmoi stores ~/.foo as dot_foo
# (private_dot_foo when it is not world-readable), so match both forms.
.env
.env.*
*dot_env
*dot_env.*
*.local
*.local.*
local.fish
fish_variables
*_history
*.netrc
*dot_netrc
**/gh/hosts.yml
.ssh/
*dot_ssh/
.gnupg/
*dot_gnupg/
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
