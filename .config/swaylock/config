font=JetBrainsMono Nerd Font
show-failed-attempts
ignore-empty-password
indicator-radius=80
indicator-thickness=8

# mistpine for swaylock: https://github.com/mistpine/mistpine.swaylock
# MIT License
#
# Save as ~/.config/swaylock/config, or add these lines to yours:
# swaylock has no include. Colors only; fonts, the indicator's size and
# images stay yours. Colors are RRGGBB or RRGGBBAA, without #.
#
# Generated by scripts/generate.ts from the mistpine spec
# (https://github.com/mistpine/mistpine/blob/main/palette/mistpine.json).
# Do not edit by hand.

# The screen: the spec's canvas, bg1.
color=0b1f27

# Typing: a bg4 ring on the canvas, keys lighting it in the accent,
# backspace in orange. No lines around the ring.
inside-color=0b1f27
ring-color=26414a
line-color=00000000
separator-color=00000000
text-color=c4c9d0
key-hl-color=6f8fa8
bs-hl-color=c98b56

# Verifying the password: the ring fills with the accent.
inside-ver-color=0b1f27
ring-ver-color=6f8fa8
line-ver-color=00000000
text-ver-color=c4c9d0

# Wrong password: red, as errors are everywhere in mistpine.
inside-wrong-color=0b1f27
ring-wrong-color=be7356
line-wrong-color=00000000
text-wrong-color=be7356

# Input cleared (Escape or Ctrl+U): yellow, a notice.
inside-clear-color=0b1f27
ring-clear-color=c2a55b
line-clear-color=00000000
text-clear-color=c2a55b

# Caps Lock on: the text says so in yellow, a warning. With
# --indicator-caps-lock (-l), keys light the ring in yellow too.
inside-caps-lock-color=0b1f27
ring-caps-lock-color=26414a
line-caps-lock-color=00000000
text-caps-lock-color=c2a55b
caps-lock-key-hl-color=c2a55b
caps-lock-bs-hl-color=c98b56

# The keyboard layout (--show-keyboard-layout): a status line chip.
layout-bg-color=0f272e
layout-border-color=00000000
layout-text-color=a7b0bb
